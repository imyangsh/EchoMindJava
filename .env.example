ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 阿里云百炼仅用于 EmbeddingModel，不会替换 Anthropic/DeepSeek ChatModel
DASHSCOPE_API_KEY=
# 默认使用北京地域公共端点；也可替换为业务空间专属域名（不含 /compatible-mode/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_EMBEDDINGS_PATH=/compatible-mode/v1/embeddings
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# 更换 embedding 模型或维度时请使用新的 collection 名称
CHROMA_COLLECTION=echomind_knowledge_dashscope_te4_1024_v1
# 生产环境务必改成强口令；本地开发默认值仅供 docker compose 快速启动
REDIS_PASSWORD=echomind123
LLM_FALLBACK_ENABLED=true
# AI 下游请求的网络超时；RAG 另有覆盖改写、召回和重排的总预算
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=30s
RAG_TOP_K=4
RAG_CANDIDATE_K=20
RAG_RERANK_K=20
RAG_MIN_RELEVANT_SCORE=0.18
RAG_HASH_MIN_RELEVANT_SCORE=0.18
RAG_MAX_CHUNK_TOKENS=512
RAG_OVERLAP_TOKENS=64
RAG_CONTEXT_MAX_TOKENS=3000
RAG_REWRITE_ENABLED=true
RAG_MAX_REWRITE_QUERIES=3
RAG_REWRITE_MIN_QUERY_CHARS=6
RAG_REWRITE_TRIGGER_SCORE=0.35
RAG_TIMEOUT_MS=30000
RAG_REWRITE_TIMEOUT_MS=3000
RAG_RERANK_TIMEOUT_MS=5000
RAG_RERANK_MAX_INPUT_TOKENS=4000
RAG_CACHE_MAX_ENTRIES=2000
RAG_CACHE_TTL_SECONDS=300
# 管理接口（/knowledge/**、/mcp/**、/eval/**、/skills/**、/monitor、/metrics）的
# API Key，请求时放在 X-API-Key 头；留空时管理接口一律拒绝访问
ECHOMIND_API_KEY=
# 动态 Skills：默认只注册 SKILL.md，失败重载保留上一成功版本
ECHOMIND_SKILLS_DIR=skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000
ECHOMIND_SKILLS_MAX_SKILL_CHARS=3200
ECHOMIND_SKILLS_LEGACY_FILES_ENABLED=false
ECHOMIND_SKILLS_MAX_FILE_BYTES=262144
ECHOMIND_SKILLS_MAX_FILES=128
ECHOMIND_SKILLS_MAX_DEPTH=8
ECHOMIND_SKILLS_ALLOW_EMPTY_RELOAD=false
# 默认使用 Anthropic；切换 DeepSeek 时改成 deepseek。
SPRING_PROFILES_ACTIVE=anthropic
